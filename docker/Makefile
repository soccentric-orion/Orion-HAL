IMAGE_NAME ?= Orion .PHONY: build run clean delete-images build: @echo "Building Docker image $(IMAGE_NAME) for Orion Platform (ARM64)..." docker buildx build --platform linux/arm64 --load --build-arg UID=$(shell id -u) --build-arg GID=$(shell id -g) -t $(IMAGE_NAME) . run: # No --gpus flag: STM32MP157F has STM32MP157F (not CUDA) docker run -it --rm --hostname STM32MP157F $(IMAGE_NAME) clean: docker rmi $(IMAGE_NAME) || true delete-images: docker rmi $(docker images -q) || true
